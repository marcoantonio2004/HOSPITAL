# Backend - Expediente Clínico Digital
# Copia este archivo como .env y ajusta los valores correspondientes a tu entorno

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expediente_clinico
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# Servidor y Entorno
PORT=3000
NODE_ENV=development

# Configuración CORS (URL del frontend en desarrollo o en Vercel)
FRONTEND_URL=http://localhost:5173

# Criptografía y Sesiones JWT
JWT_SECRET=super_secret_jwt_key_hospital_san_felipe_2026
