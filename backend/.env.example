# Backend - Expediente Clínico Digital
# Copia este archivo como .env y ajusta los valores correspondientes a tu entorno

# Base de datos PostgreSQL (Opción nube: URL completa de Supabase Session Pooler)
# Si se define DATABASE_URL, tiene prioridad sobre las variables individuales DB_*
DATABASE_URL=

# Base de datos PostgreSQL (Opción local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=expediente_clinico
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# Servidor y Entorno (development | production)
PORT=3000
NODE_ENV=development

# Configuración CORS (URL del frontend en desarrollo o en Vercel, sin diagonal final)
FRONTEND_URL=http://localhost:5173

# Criptografía y Sesiones JWT
JWT_SECRET=super_secret_jwt_key_hospital_san_felipe_2026
JWT_EXPIRES_IN=8h
